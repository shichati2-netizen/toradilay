{
  "name": "toradilay-desktop",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:app": "npm run build && node scripts/prepare-standalone.cjs",
    "start": "next start",
    "start:desktop": "node standalone/server.js",
    "build:electron": "npm run build:app && electron-builder --win portable --x64 --publish never",
    "package:win": "npm run build:app && electron-builder --win portable --x64 --publish never",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "firebase": "^12.19.0",
    "lucide-react": "^1.60.0",
    "mammoth": "^1.13.0",
    "motion": "^14.4.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "@tailwindcss/postcss": "4.1.17"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.toradilay.kiosk",
    "productName": "ToraDeliaKiosk",
    "executableName": "ToraDelia-Kiosk",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      {
        "from": "standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      },
      "package.json"
    ],
    "asar": false,
    "publish": null,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ToraDelia-Kiosk.exe",
      "requestExecutionLevel": "user"
    }
  },
  "version": "1.0.0"
}
